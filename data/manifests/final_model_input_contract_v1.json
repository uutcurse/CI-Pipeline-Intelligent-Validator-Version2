{
    "contract_version": "1.0",
    "model_id": "E06",
    "inputs": {
        "text": {
            "name": "normalized_workflow_text",
            "type": "string",
            "description": "Textual representation of the GitHub Actions workflow."
        },
        "structure": {
            "type": "vector",
            "length": 80,
            "features": [
                "job_count",
                "step_count",
                "average_steps_per_job",
                "max_steps_per_job",
                "workflow_has_name",
                "workflow_name_length",
                "trigger_count",
                "trigger_push",
                "trigger_pull_request",
                "trigger_pull_request_target",
                "trigger_workflow_dispatch",
                "trigger_schedule",
                "trigger_workflow_call",
                "trigger_repository_dispatch",
                "has_multiple_triggers",
                "dependency_edge_count",
                "jobs_with_dependencies",
                "jobs_without_dependencies",
                "max_dependency_fan_in",
                "max_dependency_fan_out",
                "dependency_graph_depth",
                "has_dependency_graph",
                "parallel_root_job_count",
                "sink_job_count",
                "unique_runner_count",
                "self_hosted_runner_count",
                "github_hosted_runner_count",
                "runner_diversity",
                "total_action_steps",
                "unique_action_count",
                "first_party_action_count",
                "third_party_action_count",
                "local_action_count",
                "docker_action_count",
                "action_version_count",
                "actions_without_explicit_version",
                "actions_at_major_version",
                "actions_at_sha",
                "run_step_count",
                "unique_shell_count",
                "multiline_command_count",
                "average_command_length",
                "max_command_length",
                "command_token_count",
                "cache_action_count",
                "artifact_upload_count",
                "artifact_download_count",
                "conditional_job_count",
                "conditional_step_count",
                "total_condition_count",
                "conditional_branch_density",
                "timeout_configured_count",
                "job_continue_on_error_count",
                "step_continue_on_error_count",
                "continue_on_error_count",
                "retry_related_configuration_count",
                "permissions_present",
                "permissions_scope_count",
                "permissions_read_count",
                "permissions_write_count",
                "has_write_permission",
                "has_broad_write_permissions",
                "global_env_variable_count",
                "secret_reference_count",
                "jobs_with_env_count",
                "steps_with_env_count",
                "environment_name_count",
                "job_container_count",
                "jobs_with_services",
                "service_count",
                "unique_service_count",
                "jobs_with_strategy",
                "jobs_with_matrix",
                "matrix_dimension_count",
                "estimated_matrix_combinations",
                "fail_fast_configured",
                "max_parallel_configured",
                "workflow_concurrency_present",
                "job_concurrency_count",
                "concurrency_configured"
            ]
        }
    },
    "transforms": {
        "text": "TfidfVectorizer (frozen)",
        "structure": "StandardScaler (frozen)"
    },
    "model": "LogisticRegression (scikit-learn)",
    "target": {
        "name": "final_label",
        "type": "integer",
        "classes": [
            0,
            1,
            2
        ],
        "mapping": {
            "0": "LOW",
            "1": "MEDIUM",
            "2": "HIGH"
        }
    },
    "forbidden_fields": [
        "repository",
        "owner",
        "repo",
        "workflow_id",
        "workflow_path",
        "commit_sha",
        "commit_date",
        "file_sha",
        "split",
        "success",
        "failure",
        "timed_out",
        "eligible_runs",
        "failure_rate",
        "meets_minimum_10",
        "provisional_class"
    ]
}